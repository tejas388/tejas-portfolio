# Backend Environment Configuration Template
# Copy this file to backend/.env and adjust settings for your environment.

# Database connection URL (defaults to backend/data/portfolio.db)
DATABASE_URL=sqlite:///./data/portfolio.db

# Allowed CORS origins for API requests (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server host and port
HOST=127.0.0.1
PORT=8000

# Resend email delivery
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_FROM_EMAIL=Your Name <onboarding@resend.dev>
NOTIFICATION_TO_EMAIL=tejas2005patel@gmail.com

# Optional Administrative Secret Key for Triggering Scheduled Reports via API
ADMIN_SECRET_KEY=change-this-secret-token-in-production
